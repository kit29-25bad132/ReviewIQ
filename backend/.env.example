# Google Gemini API Key (Required for AI Analysis)
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Optional)
# Default when unset: gemini-3.8-flash (stable model verified for this API key).
# The analyzer uses a bounded Gemini-only fallback pool (max 5 attempts per
# request, deterministic order, deduplicated). If GEMINI_MODEL is set, it is
# tried first, followed by verified fallbacks:
# gemini-flash-latest, gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.8-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
