# Google Gemini API Key (Required for AI Analysis)
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Optional)
# Default when unset: gemini-3.8-flash (stable model verified for this API key).
# The analyzer uses a bounded Gemini-only fallback pool (max 5 attempts per
# request, deterministic order, deduplicated). If GEMINI_MODEL is set, it is
# tried first, followed by verified fallbacks:
# gemini-flash-latest, gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.8-flash

# Supabase PostgreSQL connection string (V2 semantic retrieval / pgvector)
# This is the direct Postgres connection string, NOT the REST/anon URL.
# Server-side only: never expose it to the frontend or commit a real value.
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# Gemini embedding model + dimension (V2 semantic retrieval)
# Default: gemini-embedding-001 at 768 dimensions. The pgvector column and the
# runtime dimension must agree; changing the dimension requires a migration.
# Supported Gemini dimensions: 768, 1536, 3072.
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=768

# RAG retrieval context for AI analysis (V2-P3, optional)
# Disabled by default: when unset/false the analysis prompt, LangGraph state,
# and API response are byte-identical to V1/P2. Enabling requires DATABASE_URL
# plus the embedding settings above; retrieval failures never block analysis.
# RAG_ENABLED=false
# RAG_TOP_K=5
# RAG_SIMILARITY_THRESHOLD=0.35
# RAG_MAX_CONTEXT_REVIEWS=5
# RAG_MAX_CONTEXT_CHARS=6000
# RAG_MAX_REVIEW_CHARS=1000

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
