# Google Gemini API Key (Required for AI Analysis)
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Optional)
# Default when unset: gemini-3.8-flash (stable model on Google's official model list).
# If set, it is tried first, followed by at most two verified fallbacks
# (gemini-flash-latest, gemini-3.5-flash) — max 3 attempts per request.
# GEMINI_MODEL=gemini-3.8-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
