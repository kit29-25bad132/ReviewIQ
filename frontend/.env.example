# Backend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase frontend persistence (required for saving analyzed reviews)
# Use the project URL and the publishable/anon key from Supabase Project Settings > API.
# Never put the service-role/secret key in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Set exactly one frontend key. Uncomment the one provided by your Supabase project.
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
